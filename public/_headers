# Headers applied by Cloudflare to static-asset responses (HTML, CSS, JS).
# Mirrors the security headers the Worker sets on its own responses, so the
# Worker doesn't need to run for asset requests (keeps static serving free +
# CDN-cached on the Workers free tier). The three HTML pages are the exception:
# they run through the Worker so it can render the community branding into them
# (see src/branding.ts), and it re-applies these headers itself.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' https://nominatim.openstreetmap.org; frame-src https://challenges.cloudflare.com; font-src 'self'; upgrade-insecure-requests
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vendored libraries change only when the Leaflet version is bumped.
/vendor/*
  Cache-Control: public, max-age=86400

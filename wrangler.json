{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gw-member-map",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/edit", "/edit.html", "/admin", "/admin.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gw-member-map",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Midhrami Studios Member Map",
    "COMMUNITY_NAME": "Midhrami Studios",
    "COMMUNITY_URL": "https://midhrami.com"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-member-map",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/edit", "/edit.html", "/admin", "/admin.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "community-member-map",
      "migrations_dir": "migrations"
    }
  ]
}
